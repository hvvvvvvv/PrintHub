#pragma code_page(65001)
#include "resource.h"
#include <windows.h>

IDI_MANAGER_APP ICON "PrintHubManager.ico"

IDD_MANAGER_DIALOG DIALOGEX 0, 0, 500, 358
STYLE DS_SETFONT | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_THICKFRAME
CAPTION "PrintHub 服务管理面板"
FONT 9, "Microsoft YaHei UI", 0, 0, 0x1
BEGIN
    LTEXT           "服务程序：",-1,8,10,48,12
    EDITTEXT        IDC_SERVICE_PATH,58,8,350,14,ES_AUTOHSCROLL
    PUSHBUTTON      "浏览...",IDC_BROWSE_SERVICE,414,8,38,14
    PUSHBUTTON      "刷新",IDC_REFRESH,458,8,34,14
    LTEXT           "服务状态：正在检查...",IDC_SERVICE_STATUS,8,28,484,12

    GROUPBOX        "监听与协议",IDC_PROTOCOL_GROUP,8,44,484,60
    LTEXT           "监听地址：",-1,18,60,42,12
    EDITTEXT        IDC_LISTEN_ADDRESS,66,58,58,14,ES_AUTOHSCROLL
    LTEXT           "RAW 线程：",-1,132,60,48,12
    EDITTEXT        IDC_RAW_THREADS,182,58,30,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "LPD 端口：",-1,220,60,42,12
    EDITTEXT        IDC_LPD_PORT,264,58,30,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "LPD 线程：",-1,302,60,48,12
    EDITTEXT        IDC_LPD_THREADS,352,58,30,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "等待连接：",-1,390,60,45,12
    EDITTEXT        IDC_MAX_PENDING_CLIENTS,438,58,42,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "快速拒绝 SNMP 发现",IDC_SNMP_REJECT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,80,105,12
    LTEXT           "日志级别：",-1,132,81,45,12
    COMBOBOX        IDC_LOG_LEVEL,180,78,70,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "LPD 控制文件上限（字节）：",-1,260,81,100,12
    EDITTEXT        IDC_LPD_MAX_CONTROL_BYTES,365,78,65,14,ES_AUTOHSCROLL | ES_NUMBER

    GROUPBOX        "打印机映射",IDC_RAW_GROUP,8,110,484,120
    CONTROL         "RAW 端口映射",IDC_RAW_MAPPING_PAGE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,28,125,90,12
    CONTROL         "LPD 队列映射",IDC_LPD_MAPPING_PAGE,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,132,125,90,12
    LTEXT           "打印机：",IDC_RAW_PRINTER_LABEL,28,151,35,12
    COMBOBOX        IDC_PRINTER_NAME,70,149,170,110,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "端口：",IDC_RAW_PORT_LABEL,254,151,30,12
    EDITTEXT        IDC_RAW_PORT,289,149,38,14,ES_AUTOHSCROLL | ES_NUMBER
    PUSHBUTTON      "添加",IDC_ADD_RAW,345,149,44,14
    PUSHBUTTON      "删除选中项",IDC_REMOVE_RAW,405,149,65,14
    CONTROL         "",IDC_RAW_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,28,171,442,48
    LTEXT           "队列名：",IDC_LPD_QUEUE_LABEL,28,151,38,12
    EDITTEXT        IDC_LPD_QUEUE_NAME,70,149,100,14,ES_AUTOHSCROLL
    LTEXT           "打印机：",IDC_LPD_PRINTER_LABEL,182,151,35,12
    COMBOBOX        IDC_LPD_PRINTER_NAME,224,149,105,110,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "添加",IDC_ADD_LPD_QUEUE,345,149,44,14
    PUSHBUTTON      "删除选中项",IDC_REMOVE_LPD_QUEUE,405,149,65,14
    CONTROL         "",IDC_LPD_QUEUE_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,28,171,442,48

    GROUPBOX        "安装命令预览（完整参数）",IDC_COMMAND_GROUP,8,236,484,58
    EDITTEXT        IDC_COMMAND_PREVIEW,18,252,464,32,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL

    PUSHBUTTON      "安装/更新并启动",IDC_INSTALL_UPDATE,8,302,82,18
    PUSHBUTTON      "启动",IDC_START_SERVICE,96,302,38,18
    PUSHBUTTON      "停止",IDC_STOP_SERVICE,140,302,38,18
    PUSHBUTTON      "重启",IDC_RESTART_SERVICE,184,302,38,18
    PUSHBUTTON      "卸载",IDC_UNINSTALL_SERVICE,228,302,38,18
    PUSHBUTTON      "打开日志目录",IDC_OPEN_LOGS,272,302,70,18
    DEFPUSHBUTTON   "关闭",IDCANCEL,434,302,58,18
    LTEXT           "配置更新会停止、卸载、重新安装并启动服务。",IDC_OPERATION_HINT,8,330,474,12
END
